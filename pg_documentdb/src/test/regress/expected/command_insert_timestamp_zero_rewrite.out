-- Multiple zero timestamps in the same document each get a distinct increment.
CREATE OR REPLACE FUNCTION pg_temp.assert_distinct_increments() RETURNS text AS $func$
DECLARE
    stored json;
    ai     bigint;
    bi     bigint;
BEGIN
    stored := pg_temp.tsfix_get_stored(
        '{"_id":4, "a": {"$timestamp":{"t":0,"i":0}}, "b": {"$timestamp":{"t":0,"i":0}}}');
    ai := (stored->'a'->'$timestamp'->>'i')::bigint;
    bi := (stored->'b'->'$timestamp'->>'i')::bigint;
    IF ai = bi THEN
        RETURN format('TEST FAILED: increments collided (%s, %s)', ai, bi);
    END IF;
    RETURN 'TEST PASSED';
END
$func$ LANGUAGE plpgsql;
SELECT pg_temp.assert_distinct_increments();
