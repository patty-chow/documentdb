SET search_path TO documentdb_api,documentdb_core,documentdb_api_catalog;
SET documentdb_core.bsonUseEJson TO true;
SET documentdb.next_collection_id TO 2400;
SET documentdb.next_collection_index_id TO 2400;
-- Start from a clean collection so the test is deterministic regardless of
-- prior session state. Wrapped in a DO block so the return value (which
-- differs depending on whether the collection existed) does not appear in
-- the .out file.
DO $$ BEGIN PERFORM documentdb_api.drop_collection('db', 'tsrewrite'); END $$;
-- pg_temp.tsfix_get_stored: insert a document, look up the storage table for
-- the collection 'db.tsrewrite' (so the test works no matter what
-- collection id ends up being allocated), then return the stored doc as json.
CREATE OR REPLACE FUNCTION pg_temp.tsfix_get_stored(docJson text)
RETURNS json AS $func$
DECLARE
    coll_id  bigint;
    stored   json;
BEGIN
    PERFORM documentdb_api.insert_one('db', 'tsrewrite', docJson::documentdb_core.bson);
    SELECT collection_id INTO coll_id
    FROM documentdb_api_catalog.collections
    WHERE database_name='db' AND collection_name='tsrewrite';
    EXECUTE format(
        'SELECT documentdb_core.bson_to_json_string(document)::text::json
         FROM documentdb_data.documents_%s
         WHERE document @@ (format(''{ "_id": %%s }'', %L::json->''_id'')::documentdb_core.bson)',
        coll_id, docJson)
    INTO stored;
    EXECUTE format(
        'DELETE FROM documentdb_data.documents_%s
         WHERE document @@ (format(''{ "_id": %%s }'', %L::json->''_id'')::documentdb_core.bson)',
        coll_id, docJson);
    RETURN stored;
END
$func$ LANGUAGE plpgsql;
-- pg_temp.tsfix_path: navigate `obj` via a dotted path. Returns NULL if any
-- segment is missing.
CREATE OR REPLACE FUNCTION pg_temp.tsfix_path(obj json, fieldPath text)
RETURNS json AS $$
DECLARE k text;
BEGIN
    FOREACH k IN ARRAY string_to_array(fieldPath, '.') LOOP
        IF obj IS NULL OR obj->k IS NULL THEN RETURN NULL; END IF;
        obj := obj->k;
    END LOOP;
    RETURN obj;
END
$$ LANGUAGE plpgsql;
-- pg_temp.assert_ts_rewritten: insert `docJson`, expect the timestamp at
-- `fieldPath` to be rewritten to (current_time, >0). Returns 'TEST PASSED' /
-- 'TEST FAILED: ...' so the .out file is stable across runs.
CREATE OR REPLACE FUNCTION pg_temp.assert_ts_rewritten(docJson text, fieldPath text)
RETURNS text AS $func$
DECLARE
    bgn      bigint;
    end_     bigint;
    stored   json;
    ts       json;
    got_t    bigint;
    got_i    bigint;
BEGIN
    bgn := FLOOR(extract(epoch from clock_timestamp()))::bigint - 1;
    stored := pg_temp.tsfix_get_stored(docJson);
    end_ := CEIL(extract(epoch from clock_timestamp()))::bigint + 1;

    ts := pg_temp.tsfix_path(stored, fieldPath);
    IF ts IS NULL OR ts->'$timestamp' IS NULL THEN
        RETURN 'TEST FAILED: ' || fieldPath || ' is not a $timestamp';
    END IF;
    got_t := (ts->'$timestamp'->>'t')::bigint;
    got_i := (ts->'$timestamp'->>'i')::bigint;

    IF got_t NOT BETWEEN bgn AND end_ THEN
        RETURN format('TEST FAILED: %s t=%s not in [%s, %s]',
                      fieldPath, got_t, bgn, end_);
    END IF;
    IF got_i = 0 THEN
        RETURN 'TEST FAILED: ' || fieldPath || ' increment was not bumped';
    END IF;
    RETURN 'TEST PASSED';
END
$func$ LANGUAGE plpgsql;
-- pg_temp.assert_ts_preserved: insert `docJson`, expect the timestamp at
-- `fieldPath` to match (expectedT, expectedI) exactly (i.e. not rewritten).
CREATE OR REPLACE FUNCTION pg_temp.assert_ts_preserved(
    docJson text, fieldPath text, expectedT bigint, expectedI bigint)
RETURNS text AS $func$
DECLARE
    stored json;
    ts     json;
    got_t  bigint;
    got_i  bigint;
BEGIN
    stored := pg_temp.tsfix_get_stored(docJson);
    ts := pg_temp.tsfix_path(stored, fieldPath);
    IF ts IS NULL OR ts->'$timestamp' IS NULL THEN
        RETURN 'TEST FAILED: ' || fieldPath || ' is not a $timestamp';
    END IF;
    got_t := (ts->'$timestamp'->>'t')::bigint;
    got_i := (ts->'$timestamp'->>'i')::bigint;
    IF got_t <> expectedT OR got_i <> expectedI THEN
        RETURN format('TEST FAILED: %s expected (%s,%s), got (%s,%s)',
                      fieldPath, expectedT, expectedI, got_t, got_i);
    END IF;
    RETURN 'TEST PASSED';
END
$func$ LANGUAGE plpgsql;
-- Top-level Timestamp(0,0) should be rewritten to the current server timestamp.
SELECT pg_temp.assert_ts_rewritten(
    '{"_id":1, "k": {"$timestamp":{"t":0,"i":0}}}', 'k');
